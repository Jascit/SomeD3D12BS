{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/bin/${presetName}",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/bin/${presetName}/modules/",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/lib/${presetName}"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "windows x64 debug (Ninja)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/windows-x64-debug",
      "installDir": "${sourceDir}/install/windows-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_C_COMPILER": "cl"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "windows x64 release (Ninja)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/windows-x64-release",
      "installDir": "${sourceDir}/install/windows-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_C_COMPILER": "cl"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "linux x64 debug (Ninja)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/linux-x64-debug",
      "installDir": "${sourceDir}/install/linux-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "linux x64 release (Ninja)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/linux-x64-release",
      "installDir": "${sourceDir}/install/linux-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 release (Ninja)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/macOS-arm64-release",
      "installDir": "${sourceDir}/install/macOS-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-x64-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-x64-release"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-arm64-release"
    }
  ]
}